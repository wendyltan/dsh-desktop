{
  "name": "dsh-desktop-bridge",
  "version": "0.2.0",
  "description": "Local-only DeepSeek Harness adapter for dsh-desktop notifications, approvals and quick prompts.",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test:client": "node --test test/client-navigation.test.mjs"
  },
  "license": "MIT",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "market": {
      "visibility": "system",
      "owner": "dsh-desktop",
      "userManageable": false
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    },
    "guardian": {
      "protocolVersion": 1,
      "healthPath": "/dsh-desktop-bridge/status",
      "snapshotLinkedBundle": true,
      "profileFiles": []
    }
  },
  "files": ["lib", "client", "cordis.patch.yml"]
}
